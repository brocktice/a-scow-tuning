# Copy to .env on web2 and fill in. Never commit .env.

# Public base URL (used to build magic-link / invite URLs and to set secure cookies)
APP_BASE_URL=https://atuner.anfani.com
COOKIE_SECURE=true

# Bootstrap accounts that can always request a login link (the first owner / admins).
# Comma-separated. Everyone else is invite-only.
ADMIN_EMAILS=brock.tice@gmail.com

# Stalwart submission relay (see fleet-commander roles/linux_baseline_system_mail)
SMTP_HOST=mail.anfani.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=atuner@anfani.com
SMTP_PASS=CHANGEME
MAIL_FROM=A Scow Tuner <atuner@anfani.com>

# Caddy ACME contact
ACME_EMAIL=admin@anfani.com
